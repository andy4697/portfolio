{
  "name": "portfolio",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules __lwr_cache__ site",
    "dev": "lwr dev",
    "dev:compat": "lwr dev --mode compat",
    "build": "lwr build --clean && yarn copyslds",
    "build:prod-compat": "lwr build --clean --mode prod-compat",
    "start": "lwr start",
    "stage": "yarn build && yarn start",
    "stage:prod-compat": "npm run build:prod-compat && npm run start",
    "copyslds": "node ./scripts/copy-slds.mjs"
  },
  "dependencies": {
    "@salesforce-ux/design-system": "^2.26.2",
    "lwc": "latest",
    "lwr": "0.16.11"
  },
  "engines": {
    "node": ">=18.20.7"
  },
  "volta": {
    "node": "18.20.7"
  }
}
