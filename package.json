    "stage": "yarn build && yarn start",
    "stage:prod-compat": "npm run build:prod-compat && npm run start",
    "copyslds": "node ./scripts/copy-slds.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.0.9",
    "date-fns": "^4.1.0",
    "font-awesome": "^4.7.0",
    "highlight.js": "^11.11.1",
    "lwc": "latest",
    "lwr": "0.16.11",
    "marked": "^15.0.7",
    "tailwindcss": "^4.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "20.16.0"
  },
  "devDependencies": {
    "@salesforce-ux/design-system": "^2.26.2"
  }
}
