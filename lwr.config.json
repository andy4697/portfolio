{
    "lwc": { "modules": [{ "dir": "$rootDir/src/modules" }] },
    "routes": [
        {
            "id": "default",
            "path": "/",
            "layoutTemplate":"$layoutsDir/main.html",
            "rootComponent": "pages/home",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "home",
            "path": "/home",
            "layoutTemplate":"$layoutsDir/main.html",
            "rootComponent": "pages/home",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "projects",
            "path": "/projects",
            "layoutTemplate": "$layoutsDir/main.html",
            "rootComponent": "pages/projects",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "blogs",
            "path": "/blogs",
            "layoutTemplate": "$layoutsDir/main.html",
            "rootComponent": "pages/blogs",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "work",
            "path": "/work",
            "layoutTemplate": "$layoutsDir/main.html",
            "rootComponent": "pages/work",
            "bootstrap": {
                "syntheticShadow": true
            }
        },
        {
            "id": "contact",
            "path": "/contact",
            "layoutTemplate": "$layoutsDir/main.html",
            "rootComponent": "pages/contact",
            "bootstrap": {
                "syntheticShadow": true
            }
        }
    ],
    "assets": [
        {
            "alias": "assetsDir",
            "dir": "$rootDir/src/assets",
            "urlPath": "/public/assets"
        }
    ]
}
